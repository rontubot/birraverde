sys icall script backup_diario_script {
    definition {
        set fecha [clock format [clock seconds] -format "%Y%m%d"]
        set prefijo "backup_auto_"
        catch {
            tmsh::log "iCall: Iniciando backup UCS programado..."
            tmsh::save sys config ucs /var/local/ucs/${prefijo}${fecha}.ucs
            tmsh::log "iCall: Backup UCS creado exitosamente."
            exec find /var/local/ucs/ -name "${prefijo}*.ucs" -mtime +7 -exec rm -f {} \;
            tmsh::log "iCall: Limpieza de backups antiguos completada."
        }
    }
}

sys icall handler periodic backup_diario_handler {
    first-time 2026-05-20:00:00:00
    interval 1 day
    script backup_diario_script
}